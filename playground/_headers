# Cloudflare Pages response headers.
# Copied into the build output by scripts/build-playground.mjs.
# Pages already sends ETag, Brotli, X-Content-Type-Options and Referrer-Policy,
# and its own caching defaults, so this file only adds what Pages does not set.
/*
	X-Frame-Options: DENY
	Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
