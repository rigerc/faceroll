{
  "name": "faceroll",
  "version": "0.3.0",
  "description": "Expanded animated ASCII faces (asciimoji) and curated presets for AI agents: idle, working, waiting, questioning and emotions.",
  "keywords": [
    "asciimoji",
    "kaomoji",
    "ascii",
    "agent",
    "ai",
    "emoticon",
    "animation",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./terminal": {
      "import": {
        "types": "./dist/terminal.d.ts",
        "default": "./dist/terminal.js"
      },
      "require": {
        "types": "./dist/terminal.d.cts",
        "default": "./dist/terminal.cjs"
      }
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./integrations/react.d.ts",
      "import": "./integrations/react.js"
    },
    "./vue": {
      "types": "./integrations/vue.d.ts",
      "import": "./integrations/vue.js"
    },
    "./web-component": {
      "types": "./integrations/web-component.d.ts",
      "import": "./integrations/web-component.js"
    }
  },
  "bin": {
    "faceroll": "./dist/cli.js"
  },
  "files": [
    "dist",
    "integrations",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "check:size": "node scripts/check-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:fallback": "node scripts/build-fallback.mjs",
    "test:smoke": "node --test test/smoke.test.mjs",
    "playground": "npm run build:playground && node scripts/serve-playground.mjs",
    "build:playground": "npm run build && node scripts/build-playground.mjs",
    "test:playground": "node --test test/playground.test.mjs",
    "preview:cloudflare": "npm run build:playground && wrangler dev",
    "deploy:cloudflare": "npm run build:playground && wrangler deploy",
    "deploy:cloudflare:dry": "npm run build:playground && wrangler deploy --dry-run",
    "build:mcp": "npm run build && npm --prefix mcp run build",
    "test:mcp": "npm run build && npm --prefix mcp test",
    "start:mcp": "npm --prefix mcp start",
    "inspect:mcp": "npm run build:mcp && npm --prefix mcp run inspect --",
    "inspect:mcp:http": "npm --prefix mcp run inspect:http --",
    "inspect:mcp:cli": "npm run build:mcp && npm --prefix mcp run inspect:cli --",
    "inspect:mcp:http:cli": "npm --prefix mcp run inspect:http:cli --"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
